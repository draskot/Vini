#!/bin/bash

source $vini_dir/globals



# ---------------- Paths and variables ----------------
MUTATIONS_FILE="$vini_dir/database/DepMap/cell_lines/$cell_line/mutations/${cell_line}_mutations.txt"
FASTA_DIR="$vini_dir/database/genes/fasta_files"
RECEPTORS_FILE="$WORKDIR/receptors_contracted"
UNIPROT_DB="$vini_dir/database/uniprot_db"
CELL_LINE_MUT_DIR="$vini_dir/database/cell_lines/$cell_line/mutations"
SKIPPED_LOG="$WORKDIR/skipped_mutations.log"

echo "Skipped mutations log - $(date)" > "$SKIPPED_LOG"

# ---------------- Loop over CCLE mutations ----------------
while read -r line; do
    # Extract gene name (first word) and mutation (second word)
    gene=$(echo "$line" | awk '{print $1}')
    mutation=$(echo "$line" | awk '{print $2}')

    # 1️⃣ Convert gene -> UniProt ID directly
    uniprot=$(awk -v g="$gene" '$2==g {print $1; exit}' "$UNIPROT_DB")

    if [[ -z "$uniprot" ]]; then
        echo "No UniProt ID found for gene $gene. Skipping." | tee -a "$SKIPPED_LOG"
        continue
    fi

    # 2️⃣ Check if UniProt ID is in KEGG pathway
    if ! grep -qw "$uniprot" "$RECEPTORS_FILE"; then
        echo "Protein $gene ($uniprot) not in KEGG pathway. Skipping." | tee -a "$SKIPPED_LOG"
        continue
    fi

    FASTA_FILE="$FASTA_DIR/$uniprot.fasta"
    if [[ ! -f "$FASTA_FILE" ]]; then # Check if FASTA exists, download if missing
        echo "FASTA for $gene ($uniprot) missing. Downloading ..." | tee -a "$SKIPPED_LOG"
        wget -O "$FASTA_FILE" --no-check-certificate -q "https://www.uniprot.org/uniprot/${uniprot}.fasta"
        if [[ ! -f "$FASTA_FILE" ]]; then
            echo "Failed to download FASTA for $gene ($uniprot). Skipping." | tee -a "$SKIPPED_LOG"
            continue
        fi
    fi

    MUTATED_FASTA="$CELL_LINE_MUT_DIR/${uniprot}.fasta"

    echo "Applying mutation $mutation to $gene ($uniprot) ..." # Apply mutation using VINI's mutation function
    sh $vini_dir/VINI_apply_mutation "$FASTA_FILE" "$mutation" "$MUTATED_FASTA"

    MUTATED_PDB="$vini_dir/database/cell_lines/${cell_line}/mutations/${uniprot}.pdb"
    if [[ -f "$MUTATED_PDB" ]]; then
        echo "Mutated PDB for $gene ($uniprot) already exists. Skipping AlphaFold prediction." | tee -a "$SKIPPED_LOG"
    else
        outdir=$vini_dir/database/cell_lines/${cell_line}/mutations # Call AlphaFold
        sh $vini_dir/predict_with_AlphaFold ${AlphaFold_base} ${MUTATED_FASTA} ${outdir}
    fi

done < "$MUTATIONS_FILE"

sh $vini_dir/wait_until_jobs_finish
cp $vini_dir/database/cell_lines/${cell_line}/mutations/*.pdb $vini_dir/genes/pdb_files

echo "Finished processing mutations."

