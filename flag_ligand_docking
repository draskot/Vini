# Protein sidechain sampling
-ex1
-ex2

# Hydrogen / flips
-flip_HNQ true

# Robust ligand handling
-ignore_unrecognized_res
-detect_disulf false

# Packing
-packing

# RosettaScripts
-parser:protocol dock.xml

# REQUIRED for ligand docking
-run:preserve_header true

# Ligand
-extra_res_fa ligand.params

# Output control
-nstruct 1
-overwrite
