#input: Pubchem ID
#output: sdf_file in $vini_dir/database/genes/sdf_files
#output: pdb_file in $vini_dir/database/genes/pdb_files

pubchem_id=$1

pubchem_id=`echo ${pubchem_id} | tr -dc '[0-9\n]'`  #download substance sdf file from Pubchem

prefix="https://pubchem.ncbi.nlm.nih.gov/rest/pug/substance/SID/"
suffix="/record/SDF/?deposited=t&version=12&response_type=save&response_basename=Structure2D_SID_"
 
wget -O ${pubchem_id} $prefix${pubchem_id}$suffix${pubchem_id}

mv ${pubchem_id} ${pubchem_id}.sdf

obabel ${pubchem_id}.sdf -O ${pubchem_id}.pdb --gen3d best #convert to pdb with openbabel

ls -al ${pubchem_id}.*


cp ${pubchem_id}.sdf $vini_dir/database/genes/sdf_files/pubchem:${pubchem_id}.sdf
cp ${pubchem_id}.pdb $vini_dir/database/genes/pdb_files/pubchem:${pubchem_id}.pdb


