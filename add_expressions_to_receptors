source $vini_dir/globals

OUTPUT="$WORKDIR/receptors_contracted.tmp"
EXPR_FILE="$vini_dir/database/cell_lines/${cell_line}/expressions/${cell_line}_expression.txt"
UNIPROT_DB="$vini_dir/database/uniprot_db"

# Truncate file WITHOUT adding a blank line
: > "$OUTPUT"

while read -r line; do

    uniprot=$(echo "$line" | awk '{print $3}')
    flag=$(echo "$line" | awk '{print $4}')

    # Detect proteins vs compounds
    if [[ "$uniprot" == pubchem* ]]; then
        entry="pubchem"
    else
        entry="protein"
    fi

    if [[ "$entry" == "protein" ]]; then

        # UniProt -> GENE mapping
        gene=$(awk -v u="$uniprot" '$1==u {print $2}' "$UNIPROT_DB")

        if [[ -z "$gene" ]]; then
            echo "Warning: gene not found for UniProt $uniprot → expr=0"
            expr=0.000
        else
            # Expression lookup
            expr=$(awk -v g="$gene" '$1==g {print $2}' "$EXPR_FILE")
            [[ -z "$expr" ]] && expr=0.000
        fi

    else
        # Compounds → expression = 0
        expr=0.000
    fi

    # nge = expr + 1
    nge=$(awk -v x="$expr" 'BEGIN{printf "%.9f", x+1.0}')

    # Write final line
    echo "$line $expr $nge" >> "$OUTPUT"

done < "$WORKDIR/receptors_contracted"

mv "$OUTPUT" "$WORKDIR/receptors_contracted"

