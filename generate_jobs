#!/bin/bash
set -euo pipefail

# Standard clean exports
export vini_dir=$HOME/Vini
source "$vini_dir/sourceme"
source "$vini_dir/globals"

ncpus=48
jobs_dir="$WORKDIR/${cancer_type}_data/${cell_line}"
matrix_file="$jobs_dir/Initial_matrix"

mkdir -p "$jobs_dir"
nrows=$(wc -l < "$matrix_file")
echo "Matrix has $nrows rows"

# 🌟 PURE PYTHON MATRIX SCANNER - No backslash bugs, no tab-splitting errors 🌟
# It reads your 96x96 Initial_matrix and outputs clean rows for Bash to process.
active_jobs=$(python3 - <<'EOF'
import os
with open(os.environ["WORKDIR"] + "/" + os.environ["cancer_type"] + "_data/" + os.environ["cell_line"] + "/Initial_matrix", "r") as f:
    for row_idx, line in enumerate(f):
        elements = line.strip().split("\t")
        for j in range(row_idx + 1, len(elements)):
            val = elements[j].strip()
            if val and val != "0":
                print(f"{row_idx} {j} {val}")
EOF
)

if [[ -z "$active_jobs" ]]; then
    echo "[VINI] No interacting pairs found in Initial_matrix."
    exit 0
fi

# Standard clean Bash loop over discovered interactions
echo "$active_jobs" | while read -r row_index j element; do
    IFS=',' read -r name1 name2 type expr <<< "$element"
    [[ -z "$type" ]] && continue
    
    job_dir="$jobs_dir/job_${row_index}_${j}"
    job_path="$job_dir/job.sh"
    mkdir -p "$job_dir"
    
    echo "Generating: job_${row_index}_${j} -> name1: $name1 name2: $name2 type: $type"
    
    {
        partition=$CPU_PARTITION
        if [[ "$SCTYPE" == "SLURM" ]]; then
            walltime=$(sinfo -o "%R %l" | awk -v p="$partition" '$1==p {print $2; exit}')
        else
            walltime="48:00:00"
        fi
        
        if [[ "$SCTYPE" == "SLURM" ]]; then
            echo "#!/bin/bash"
            echo "#SBATCH --job-name=job_${row_index}_${j}"
            echo "#SBATCH --partition=$CPU_PARTITION"
            echo "#SBATCH --time=$walltime"
            echo "#SBATCH --account=$ACCOUNT"
            echo "#SBATCH --nodes=1"
            echo "#SBATCH --ntasks=1"
            echo "#SBATCH --cpus-per-task=$ncpus"
            echo "#SBATCH --threads-per-core=1"
            echo "#SBATCH --output=$job_dir/job.out"
            echo "#SBATCH --error=$job_dir/job.err"
            echo "export OMP_NUM_THREADS=\$SLURM_CPUS_PER_TASK"
        else
            echo "#PBS -l select=1:ncpus=${ncpus}"
            echo "#PBS -l walltime=48:00:00"
            echo "#PBS -q $CPU_PARTITION"
            echo "#PBS -N job_${row_index}_${j}"
            echo "#PBS -o $job_dir/job.out"
            echo "#PBS -e $job_dir/job.err"
        fi
        
        echo "cd $job_dir"
        echo "source $vini_dir/sourceme"
        
        if [[ "$type" == "PP" || "$type" == "GE" ]]; then
            echo "cp $WORKDIR/${cancer_type}_data/${cell_line}/${name1}.pdb ./"
            echo "cp $WORKDIR/${cancer_type}_data/${cell_line}/${name2}.pdb ./"
            echo "sed -i '/^REMARK/d' ${name1}.pdb ${name2}.pdb"
            echo "chain=\$(head -1 ${name2}.pdb | awk '{print \$5}')"
            echo "if [[ \"\$chain\" == \"A\" ]]"
            echo "then"
            echo "    java -jar $vini_dir/PDBChainNameSupstitutor-1.0-SNAPSHOT-shaded.jar ${name2}.pdb \"\$chain\" B"
            echo "    mv  ${name2}.pdb_A_to_B.pdb  ${name2}.pdb"
            echo "fi"
            echo "cp $vini_dir/docking_default.mac ./tmp"
            echo "sed -e \"s/receptor\\.pdb/${name1}.pdb/g\" -e \"s/ligand\\.pdb/${name2}.pdb/g\" -e \"s/complex\\.pdb/C_${name1}_${name2}.pdb/g\" tmp > docking.mac"
            echo "hex -batch ${name1}.pdb ${name2}.pdb < docking.mac"
            echo "sed -i '/^REMARK/d' ${name1}.pdb"
            echo "sed -i '/^REMARK/d' ${name2}.pdb"
            echo "sed -i '/^REMARK/d' C_${name1}_${name2}.pdb"
            echo "cp \$ROSETTA_PUB/clean_pdb_keep_ligand.py ."
            echo "cp \$ROSETTA_TOOLS/amino_acids.py ."
            echo "source \$INSTALL/miniconda2/bin/activate"
            echo "\$INSTALL/miniconda2/bin/python clean_pdb_keep_ligand.py C_${name1}_${name2}.pdb -ignorechain"
            echo "mv C_${name1}_${name2}.pdb_00.pdb C_${name1}_${name2}.pdb"
            echo "conda deactivate"
            echo "cp $vini_dir/flag_input_relax $vini_dir/flag_global_docking ./"
            echo "receptor_chains=\$(grep '^ATOM' ${name1}.pdb | awk '{print \$5}' | sort | uniq | tr -d '\n')"
            echo "ligand_chains=\$(grep '^ATOM' ${name2}.pdb | awk '{print \$5}' | sort | uniq | tr -d '\n')"
            echo "partners_line=\${receptor_chains}_\${ligand_chains}"
            echo "sed -i -e \"s/-partners .*/-partners \${partners_line}/\" flag_global_docking"
            echo "\$ROSETTA/source/bin/relax.cxx11thread.linuxgccrelease -in:file:s C_${name1}_${name2}.pdb -multithreading:total_threads ${ncpus} @flag_input_relax -overwrite"
            echo "\$ROSETTA/source/bin/docking_protocol.cxx11thread.linuxgccrelease -in:file:s C_${name1}_${name2}_0001.pdb -multithreading:total_threads ${ncpus} @flag_global_docking"
        else
            echo "if [[ \"\$name1\" == pubchem:* ]]; then"
            echo "    ligand=\"\$name1\""
            echo "    receptor=\"\$name2\""
            echo "else"
            echo "    ligand=\"\$name2\""
            echo "    receptor=\"\$name1\""
            echo "fi"
            echo "cp $WORKDIR/${cancer_type}_data/${cell_line}/\${receptor}.pdb receptor.pdb"
        fi
    } > "$job_path"
    chmod +x "$job_path"
    # 🌟 SUBMIT THE JOBS TO THE CLUSTER QUEUE 🌟
    if [[ "$SCTYPE" == "SLURM" ]]; then
        sbatch "$job_path" > /dev/null
    elif [[ "$SCTYPE" == "PBS" ]]; then
        qsub "$job_path" > /dev/null
    else
        echo "Warning: Unknown scheduler type '$SCTYPE'. Job created but not submitted."
    fi
done

echo "[VINI] Script scanning completed. All jobs compiled from Initial_matrix."
