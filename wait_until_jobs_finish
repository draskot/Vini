#!/bin/bash

source "$vini_dir/globals"

echo "[VINI] Waiting for jobs to finish (ignoring CG)..."

while true; do
    if [[ "$SCTYPE" == "SLURM" ]]; then
        njobs=$(squeue -u "$USER" -h -o "%T" | grep -E 'RUNNING|PENDING' | wc -l)
    else
	njobs=$(qstat -u "$USER" 2>/dev/null | awk 'NR>5 {count++} END {print count+0}')
    fi

    if [[ "$njobs" -eq 0 ]]; then
        break
    fi

    echo "[VINI] Jobs remaining: $njobs"
    sleep 30
done

echo "[VINI] All jobs finished."

