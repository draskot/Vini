#!/bin/bash

echo "=== Hex Installer ==="

# ----------------------------
#  Load variables from sourceme
# ----------------------------
if [ -z "$vini_dir" ]; then
    vini_dir="$(cd "$(dirname "${BASH_SOURCE}")" && pwd)"
fi

SOURCEME="$vini_dir/sourceme"

if [ ! -f "$SOURCEME" ]; then
    echo "ERROR: $SOURCEME not found!"
    exit 1
fi

INSTALL=$(grep "^export INSTALL=" "$SOURCEME" | sed 's/export INSTALL=//' | tr -d '"'\''')

if [ -z "$INSTALL" ]; then
    echo "ERROR: INSTALL variable not found in $SOURCEME"
    exit 1
fi

echo "Using INSTALL directory: $INSTALL"

HEX_FILE="hex-8.1.1-x64-centos7.run"
HEX_SRC="$vini_dir/database/$HEX_FILE"
HEX_RUN="$INSTALL/$HEX_FILE"
HEX_DEST="$INSTALL/hex-8.1.1"

# ----------------------------
# 1. Check if Hex is already registered
# ----------------------------
if grep -q "Hex section" "$SOURCEME"; then
    echo "Hex already appears in sourceme -> skipping installation."
    exit 0
fi

echo "Hex is not yet installed. Proceeding..."

# ----------------------------
# 2. Copy bundled installer from VINI database into $INSTALL
# ----------------------------
if [ -f "$HEX_SRC" ]; then
    echo "Copying bundled Hex installer from $HEX_SRC to $INSTALL..."
    cp -f "$HEX_SRC" "$HEX_RUN" || {
        echo "ERROR: Failed to copy $HEX_SRC to $HEX_RUN!"
        exit 1
    }
elif [ ! -f "$HEX_RUN" ]; then
    echo "ERROR: Bundled Hex installer not found at $HEX_SRC or $HEX_RUN!"
    exit 1
fi

chmod +x "$HEX_RUN"

# ----------------------------
# 3. Run installer (try unattended into $HEX_DEST first, fallback to text/interactive)
# ----------------------------
echo ""
echo ">>> Installing Hex into $HEX_DEST..."
echo ""

rm -rf "$HEX_DEST"
if ! "$HEX_RUN" --mode unattended --prefix "$HEX_DEST" 2>/dev/null; then
    echo "Starting interactive terminal Hex installer..."
    echo ">>> When prompted for installation directory, enter: $HEX_DEST"
    unset DISPLAY
    "$HEX_RUN" --mode text || "$HEX_RUN" || {
        echo "ERROR: Hex installer exited with errors."
        rm -f "$HEX_RUN"
        exit 1
    }
fi

# ----------------------------
# 4. Detect Hex executable location and append to sourceme
# ----------------------------
HEX_BIN=$(find "$INSTALL" -maxdepth 3 -type f -name "hex" -perm -u+x 2>/dev/null | head -n 1)

if [ -z "$HEX_BIN" ]; then
    echo "WARNING: Hex executable not found inside $INSTALL"
    echo "You may need to manually adjust PATH."
    rm -f "$HEX_RUN"
    exit 1
else
    HEX_BIN_DIR=$(dirname "$HEX_BIN")
    echo "Detected Hex executable at: $HEX_BIN"

    {
        echo ""
        echo "# ***** Hex section *****"
        echo "export PATH=\"\$PATH:$HEX_BIN_DIR\""
    } >> "$SOURCEME"

    rm -f "$HEX_RUN"
    echo "Hex PATH ($HEX_BIN_DIR) added to $SOURCEME"
fi

echo "=== Hex setup complete ==="
