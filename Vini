else
    jobs=$(qstat -u "$USER" | awk 'NR>5 {print $1}' | sed 's/\..*//')
    cancel_cmd="qdel"
fi

if [[ -z "$jobs" ]]; then
    echo "no jobs to cancel."
else
    for job in $jobs; do
