#--------------------------------------
# Detect workload manager
#--------------------------------------
if command -v sinfo >/dev/null 2>&1; then
    SCTYPE="SLURM"
elif command -v pbsnodes >/dev/null 2>&1; then
    SCTYPE="PBS"
else
    echo "No supported workload manager detected (SLURM/PBS)."
    exit 1
fi

echo "export SCTYPE=$SCTYPE" >> "$vini_dir/globals"

if [ "$SCTYPE" = "SLURM" ]; then
    echo "export job_status=squeue"   >> "$vini_dir/globals"
    echo "export job_submit=sbatch"   >> "$vini_dir/globals"
    echo "export job_cancel=scancel"  >> "$vini_dir/globals"

    echo "Available SLURM partitions:"
    sinfo

    # ---------------- CPU partition ----------------
    read -p "Enter CPU partition (Rosetta, Vina, etc): " CPU_PARTITION
    echo "export CPU_PARTITION=$CPU_PARTITION" >> "$vini_dir/globals"

    cores_per_node=$(sinfo -o "%P %c" -p "$CPU_PARTITION" | awk 'NR==2 {print $2}')
    memory_per_node=$(sinfo -o "%P %m" -p "$CPU_PARTITION" | awk 'NR==2 {print int($2)}')

    echo "export cores_per_node=$cores_per_node" >> "$vini_dir/globals"
    echo "export memory_per_node=$memory_per_node" >> "$vini_dir/globals"

    bash detects_max_walltime_on_SLURM "$CPU_PARTITION"

    # ---------------- GPU partition ----------------
    read -p "Enter GPU partition (AlphaFold): " GPU_PARTITION
    echo "export GPU_PARTITION=$GPU_PARTITION" >> "$vini_dir/globals"

    gpu_info=$(sinfo -o "%G" -p "$GPU_PARTITION" | awk 'NR==2 {print $1}')

    if [[ "$gpu_info" != *gpu* ]]; then
        echo "WARNING: Selected GPU partition does not report GPUs!"
    fi

    # Conservative default (override later if needed)
    gpus_per_node=4
    echo "export GPUS_PER_NODE=$gpus_per_node" >> "$vini_dir/globals"

    bash detects_max_walltime_on_SLURM "$GPU_PARTITION"
fi

if [ "$SCTYPE" = "PBS" ]; then
    echo "export job_status=qstat" >> "$vini_dir/globals"
    echo "export job_submit=qsub"  >> "$vini_dir/globals"
    echo "export job_cancel=qdel"  >> "$vini_dir/globals"

    echo "Available PBS queues:"
    qstat -Q

    # ---------------- CPU queue ----------------
    read -p "Enter CPU queue (Rosetta, Vina, etc): " CPU_PARTITION
    echo "export CPU_PARTITION=$CPU_PARTITION" >> "$vini_dir/globals"

    bash detects_cores_on_PBS "$CPU_PARTITION"
    bash detects_memsize_on_PBS "$CPU_PARTITION"
    bash detects_max_walltime_on_PBS "$CPU_PARTITION"

    # ---------------- GPU queue ----------------
    read -p "Enter GPU queue (AlphaFold): " GPU_PARTITION
    echo "export GPU_PARTITION=$GPU_PARTITION" >> "$vini_dir/globals"

    # Conservative assumption
    gpus_per_node=4
    echo "export GPUS_PER_NODE=$gpus_per_node" >> "$vini_dir/globals"

    bash detects_max_walltime_on_PBS "$GPU_PARTITION"
fi


