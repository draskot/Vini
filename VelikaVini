vini_dir=$HOME/Vini
source $vini_dir/globals

echo "Cleaning the sytem from previous run, please wait..."

> $WORKDIR/missing_genes
> $WORKDIR/failed_predictions
> $WORKDIR/SLEM_values    #delete SLEM values from the previous run
rm -f $WORKDIR/slem*

find "$WORKDIR" -maxdepth 1 -type f -name 'dock*' -print0 | xargs -0 rm -f

rm -f $WORKDIR/postproc*
rm -f $WORKDIR/SLEM*
rm -f $vini_dir/genes/cosmic_ids.csv

find "$WORKDIR" -maxdepth 1 -type d -regextype posix-egrep -regex '.*/[0-9_]+$' -print -exec rm -rf {} \;

echo "done."

nr_ligands=`wc -l < $vini_dir/ligands/ligands_list`
#nr_complexes=`cat $WORKDIR/nr_complexes`

data="_data"
mkdir -p $vini_dir/database/KEGG_cancer_pathways

mkdir -p $WORKDIR/${cancer_type}_data           #folder with an intermediate data
grep $cancer_type $vini_dir/database/cross_references > tmp
line=`cat tmp`
tissue=`echo $line | awk '{print $2}'`
mkdir -p $vini_dir/database/KEGG_cancer_pathways/$CANCER_PATHWAY

echo -n "Downloading KEGG $CANCER_PATHWAY pathway..."
sh download_KEGG_pathway
echo "done."

echo "Processing" $CANCER_PATHWAY "metabolic pathway" 
start_date=`date`
echo "Analysis started at ${start_date} "
rm -f $WORKDIR/END

echo "Creating relations and receptors files in $WORKDIR folder..."
sh $vini_dir/create_relations_receptors_files #create KEGG receptor structures
echo "done."

echo "Creating KEGG receptor structures..."
sh $vini_dir/create_receptor_structures
echo " done ."

if  [ -s $WORKDIR/missing_genes ]
then
    echo "Cannot continue as the following KEGG genes are missing entry in Uniprot:"
    cat $WORKDIR/missing_genes
    echo "Find their fasta sequences at https://www.ncbi.nlm.nih.gov/ and predict their structures."
    #echo "Then upload structures to $vini_dir/database/genes/pdb_files directory and start Vini again."
    echo "Then upload structures to $vini_dir/database/genes/pdb_files/$cell_line and start VINI again."
fi

if  [ -s $WORKDIR/failed_pubchem_structures ]
then
    echo "Cannot continue as Openbabel failed sdf to pdb conversion for the following KEGG substances:"
    cat $WORKDIR/failed_pubchem_structures              
    echo "You may try to convert them with Cactus server: https://cactus.nci.nih.gov/translate/"
    echo "Then upload these strucures to $vini_dir/database/genes/pdb_files/$cell_line directory and start Vini again."
    echo "Exiting." ; exit
fi

if [ ! -e $vini_dir/ligands/${cell_line} ]
then
    echo -n "Performing cleanup..."
    while read -r line
    do
        drug=`echo $line | awk -F',' '{print $1}'`
        type=`echo $line | awk -F',' '{print $2}'`
        if  [ $type == P ]
        then
            echo -n "."
            rm -f $WORKDIR/AlphaFold_${drug}
            rm -f $WORKDIR/${drug}.err $WORKDIR/${drug}.out
            rm -rf $WORKDIR/${drug}
        fi
    done < $vini_dir/ligands/ligands_list

    mkdir -p $vini_dir/ligands/${cell_line}
    echo "Predicting mAb drug structures with AlphaFold. May take a while, do not interrupt!."
    sh $vini_dir/predict_protein_drug_structures
    sh $vini_dir/wait_until_jobs_finish
fi

cp -r $vini_dir/ligands/${cell_line} $vini_dir/ligands/pdb_files
cp -r $vini_dir/ligands/${cell_line} $vini_dir/database/ligands/pdb_files

 
if  [ $CCLE == y ]
then
    rm -f $WORKDIR/*err $WORKDIR/*out    
    sh $vini_dir/predict_mutated_genes
fi


echo -n "Adding expressions to $WORKDIR/receptors file..."
sh add_cell_expressions_to_receptors
tail -n +2 $WORKDIR/receptors_contracted > tmp ; mv tmp $WORKDIR/receptors_contracted #delete 1st empty line in receptors file 


echo -n "Adding expressions to $WORKDIR/relations file..."
source $INSTALL/miniconda3/bin/activate
conda activate env310
python add_cell_expressions_to_relations.py
conda deactivate


if [ $kit == y ]
then
    while read -r line
    do
        uniprotID=`echo $line | awk '{print $2}'`
        expression=`echo $line | awk '{print $3}'`
        echo $uniprotID
        echo $expression
        grep $uniprotID $WORKDIR/receptors_contracted > tmp
        if [ -s tmp ]
        then
            echo "gene found"
        else
            echo "gene not found" 
        fi
    done < $vini_dir/database/genes/custom_genes
fi


while read -r line  #Cleanup
do
    receptor=`echo $line | awk '{print $3}'`
    state=`echo $line | awk '{print $4}'`
    if  [ $state == W ]
    then
        echo -n "."
        rm -f $WORKDIR/AlphaFold_${receptor}
        rm -f $WORKDIR/${receptor}.err $WORKDIR/${receptor}.out
        rm -rf $WORKDIR/${receptor}
    fi
done < $WORKDIR/receptors_contracted ; echo "done."


j=1
mkdir -p $WORKDIR/${cancer_type}_data      #prepare receptors
cp $ROSETTA_TOOLS/amino_acids.py ./
cp $ROSETTA_PUB/clean_pdb_keep_ligand.py ./

source $INSTALL/miniconda2/bin/activate
echo "Copying receptor structures to $WORKDIR/${cancer_type}_data/${cell_line} area."
mkdir -p $WORKDIR/${cancer_type}_data/${cell_line}
while  read -r line
do
       printf -v i "%03d" $j
       gene=`echo $line | awk '{print $3}'` #get receptor name
       cp $vini_dir/database/genes/pdb_files/${gene}.pdb ./
       grep COMPND ${gene}.pdb > tmp
       if [ ! -s tmp ]
       then
           grep ATOM ${gene}.pdb > tmp.pdb
           python clean_pdb_keep_ligand.py tmp.pdb -ignorechain
           mv tmp.pdb_00.pdb ${gene}.pdb
           chain=`head -1 ${gene}.pdb | awk  '{print $5}'`
           if  [ $chain != A ]
           then
               java -jar $vini_dir/PDBChainNameSupstitutor-1.0-SNAPSHOT-shaded.jar ${gene}.pdb $chain A
               mv ${gene}.pdb_${chain}_to_A.pdb ${gene}.pdb
           fi
           grep -v TER ${gene}.pdb  > tmp   #adjust PDB format
           echo "TER                                                                           " >> tmp
           cp tmp $WORKDIR/${cancer_type}_data/${cell_line}/complex_${i}.pdb
           cp tmp $WORKDIR/${cancer_type}_data/${cell_line}/${gene}.pdb
       else
           cp ${gene}.pdb $WORKDIR/${cancer_type}_data/${cell_line}/complex_${i}.pdb
           cp ${gene}.pdb $WORKDIR/${cancer_type}_data/${cell_line}/${gene}.pdb
       fi
       rm ${gene}.pdb
       let j++
done < $WORKDIR/receptors_contracted
conda deactivate

WORK_MATRIX="${WORKDIR}/${cancer_type}_data/${cell_line}/Intermediate_matrix"
DB_DIR="${vini_dir}/database/cell_lines/${cell_line}"

# -----------------------------------------------------------------
# 1. Source the latest global states to check for pathway updates
# -----------------------------------------------------------------
if [[ -f "$vini_dir/globals" ]]; then
    source "$vini_dir/globals"
fi

# Set a default value 'N' if the variable isn't set in globals
PATHWAY_UPDATED_STATUS="${Pathway_updated:-N}"

# -----------------------------------------------------------------
# 2. Check cache OR force rebuild if pathway was updated
# -----------------------------------------------------------------
if [[ -f "$DB_DIR/Intermediate_matrix" && "$PATHWAY_UPDATED_STATUS" != "Y" ]]; then
    echo "Intermediate matrix exists in database folder $DB_DIR, copying it to ${WORKDIR}/${cancer_type}_data/${cell_line} folder"
    cp "$DB_DIR/Intermediate_matrix" "$WORK_MATRIX"
else
    if [[ "$PATHWAY_UPDATED_STATUS" == "Y" ]]; then
        echo "[VINI ALERT] New KEGG pathway detected. Invalidating and removing old matrices..."
        rm -f "$DB_DIR/Intermediate_matrix"
        rm -f "$WORK_MATRIX"
    fi

    echo -n "Creating Initial_matrix..."
    source "$INSTALL/miniconda3/bin/activate"
    conda activate env310
    python create_initial_matrix.py
    conda deactivate

    # 1. Generate jobs and wait until they finish
    sh "$vini_dir/generate_jobs"   # Rosetta predicts binding energies
    sh "$vini_dir/wait_until_jobs_finish"

    echo "done."

    # 2. Generate Intermediate_matrix
    source "$INSTALL/miniconda3/bin/activate"
    conda activate env310
    python "create_intermediate_matrix.py"
    conda deactivate
    echo "done."

    # 3. Cache the fresh harmonized matrix layout for future high-speed reuse
    cp "$WORK_MATRIX" "$DB_DIR/Intermediate_matrix"

    # 🌟 NEW: RESET THE PATHWAY STATE IN GLOBALS 🌟
    # This prevents Vini from wiping the cache on your very next run!
    if [[ -f "$vini_dir/globals" ]]; then
        sed -i 's/export Pathway_updated=Y/export Pathway_updated=N/g' "$vini_dir/globals"
        echo "[VINI] Pathway update state reset to N in globals."
    fi

fi

i=1
rm -f $WORKDIR/ligands_stage/*
while  read -r line                                               #Copy ligand files to the stage
do
    drug=`echo $line | awk -F',' '{print $1}'`
    type=`echo $line | awk -F',' '{print $2}'`
    printf -v lig_index "%03d" $i
    echo "Copying "${drug}" structure to the stagging area."
    if  [ $type == S ]
    then
        cp $vini_dir/ligands/pdb_files/"${drug}".pdb $WORKDIR/ligands_stage/ligand_${lig_index}.pdb
        cp $vini_dir/ligands/pdbqt_files/"$drug".pdbqt $WORKDIR/ligands_stage/ligand_${lig_index}.pdbqt
    else
        cp $vini_dir/ligands/pdb_files/"${drug}".pdb $WORKDIR/ligands_stage/ligand_${lig_index}.pdb
    fi
    let i++
done < $vini_dir/ligands/ligands_list


nr_complexes=`wc -l $WORKDIR/receptors_contracted | awk '{ print $1 }'`
echo $nr_complexes > $WORKDIR/nr_complexes
for (( therapy_level=1; therapy_level<=max_therapy_level; therapy_level++ ))
do
    echo $therapy_level > $vini_dir/therapy_level
    sh $vini_dir/malavini
    sh $vini_dir/wait_until_jobs_finish
done
