#!/bin/bash

set -e

echo -n "Checking if BCL is installed... "
if grep -q BCL "$vini_dir/sourceme"; then
    echo "yes."
    exit 0
fi
echo "no."

module purge

# ---- activate Miniconda2 (assumed to exist) ----
source "$INSTALL/miniconda2/bin/activate"

# ---- load CMake module (assume always present) ----
# Identify first available CMake module via spider
CMAKE_MOD=$(module spider cmake 2>&1 | grep -E '^[[:space:]]+[0-9]' | head -n1 | awk '{print $1}')
module load "$CMAKE_MOD"

# ---- load Intel compiler toolchain (robust, minimal-fragility) ----
if module load intel-oneapi-compilers 2>/dev/null; then
    :
elif module load oneapi/icc 2>/dev/null; then
    :
elif module load utils/spack/latest 2>/dev/null \
     && module load intel-oneapi-compilers 2>/dev/null; then
    :
else
    echo "ERROR: Unable to load Intel compiler toolchain."
    echo "Please load the appropriate compiler modules manually."
    exit 1
fi

echo "Installing BCL. Cleaning previous sources..."

rm -f  "$INSTALL/master.zip"
rm -rf "$INSTALL/bcl-master"

# ---- pin BCL to a fixed commit for reproducibility ----
BCL_COMMIT="f8d7f97"  # Example commit hash
wget -q -P "$INSTALL" "https://github.com/BCLCommons/bcl/archive/${BCL_COMMIT}.zip"

unzip -q -o "$INSTALL/${BCL_COMMIT}.zip" -d "$INSTALL"
rm -f "$INSTALL/${BCL_COMMIT}.zip"

cd "$INSTALL/bcl-${BCL_COMMIT}"

# ---- build BCL using default CPU command-line build ----
./scripts/build/build_cmdline.linux.sh

# ---- deactivate Miniconda2 environment ----
conda deactivate

# ---- update environment ----
{
    echo "#******* BCL section *******"
    echo "export PATH=$INSTALL/bcl-${BCL_COMMIT}/build/linux64_release/bin:\$PATH"
} >> "$vini_dir/sourceme"

echo "BCL installation finished successfully."

